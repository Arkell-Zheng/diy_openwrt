#===============================================================================
# OpenWrt 配置文件 - 红米AC2100 精简版
# 设备: Xiaomi Redmi Router AC2100
# 目标: ramips/mt7621
# 方案: 精简版 (约60-80MB)
#===============================================================================

#===============================================================================
# 目标平台配置
#===============================================================================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_redmi-router-ac2100=y

#===============================================================================
# 固件设置
#===============================================================================
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=96

#===============================================================================
# 编译选项
#===============================================================================
CONFIG_DEVEL=y
CONFIG_CCACHE=y
# CONFIG_BUILD_LOG is not set

#===============================================================================
# 基础系统
#===============================================================================
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_uclient-fetch=y

#===============================================================================
# 内核模块 - 无线驱动
#===============================================================================
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_kmod-mt7615e=y
CONFIG_PACKAGE_kmod-mt7615-firmware=y
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set

#===============================================================================
# 内核模块 - 网络优化
#===============================================================================
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-nf-nathelper=y
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y
CONFIG_PACKAGE_kmod-ipt-raw=y
CONFIG_PACKAGE_kmod-ipt-offload=y

#===============================================================================
# 内核模块 - USB存储支持
#===============================================================================
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

#===============================================================================
# 内核模块 - 文件系统
#===============================================================================
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y

#===============================================================================
# LuCI Web界面
#===============================================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-ipkg=y

#===============================================================================
# 中文语言支持
#===============================================================================
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y

#===============================================================================
# Argon 主题
#===============================================================================
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

#===============================================================================
# 科学上网 - PassWall (推荐)
#===============================================================================
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y

# PassWall 核心组件
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_shadowsocks-libev-ss-local=y
CONFIG_PACKAGE_shadowsocks-libev-ss-redir=y
CONFIG_PACKAGE_shadowsocks-libev-ss-server=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-local=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir=y
CONFIG_PACKAGE_simple-obfs=y
CONFIG_PACKAGE_trojan-plus=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_dns2socks=y
CONFIG_PACKAGE_dns2tcp=y
CONFIG_PACKAGE_ipt2socks=y
CONFIG_PACKAGE_microsocks=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_haproxy=y

# 如果需要 SSR Plus+ 替代 PassWall，取消下面注释并注释上面 PassWall 部分
# CONFIG_PACKAGE_luci-app-ssr-plus=y
# CONFIG_PACKAGE_luci-i18n-ssr-plus-zh-cn=y

#===============================================================================
# 广告屏蔽 - AdGuard Home
#===============================================================================
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_adguardhome=y

#===============================================================================
# 下载工具 - Aria2
#===============================================================================
CONFIG_PACKAGE_luci-app-aria2=y
CONFIG_PACKAGE_luci-i18n-aria2-zh-cn=y
CONFIG_PACKAGE_aria2=y
CONFIG_PACKAGE_ariang=y

#===============================================================================
# DDNS 动态域名
#===============================================================================
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_ddns-scripts-aliyun=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y

#===============================================================================
# 流量统计
#===============================================================================
# vnStat 历史统计
CONFIG_PACKAGE_luci-app-vnstat=y
CONFIG_PACKAGE_luci-i18n-vnstat-zh-cn=y
CONFIG_PACKAGE_vnstat=y
CONFIG_PACKAGE_vnstati=y

# nlbwmon 实时统计
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_nlbwmon=y

#===============================================================================
# USB 文件共享 - Samba4
#===============================================================================
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockd=y

#===============================================================================
# 系统工具
#===============================================================================
# 网页终端
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_ttyd=y

# UPnP
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_miniupnpd=y

# 防火墙增强
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# 定时重启
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y

# 网络唤醒
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_etherwake=y

#===============================================================================
# IPv6 支持
#===============================================================================
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-proto-ipv6=y

#===============================================================================
# 网络诊断工具
#===============================================================================
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_iperf3=y

#===============================================================================
# QoS 流量控制
#===============================================================================
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_sqm-scripts=y

#===============================================================================
# SmartDNS 智能DNS
#===============================================================================
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y
CONFIG_PACKAGE_smartdns=y

#===============================================================================
# 内网穿透 - frpc
#===============================================================================
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-i18n-frpc-zh-cn=y
CONFIG_PACKAGE_frpc=y

#===============================================================================
# ZeroTier 组网 (可选)
#===============================================================================
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y
CONFIG_PACKAGE_zerotier=y

#===============================================================================
# 基础工具
#===============================================================================
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_openssh-sftp-server=y

#===============================================================================
# DNS 配置
#===============================================================================
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y

#===============================================================================
# 可选功能 - 按需取消注释
#===============================================================================

# ===== OpenClash (Clash内核，占用较大) =====
# CONFIG_PACKAGE_luci-app-openclash=y

# ===== 视频下载工具 (需要Python环境，占用较大) =====
# CONFIG_PACKAGE_python3=y
# CONFIG_PACKAGE_python3-pip=y
# CONFIG_PACKAGE_yt-dlp=y
# CONFIG_PACKAGE_ffmpeg=y

# ===== 系统监控图表 (占用较多) =====
# CONFIG_PACKAGE_luci-app-statistics=y
# CONFIG_PACKAGE_collectd=y
# CONFIG_PACKAGE_collectd-mod-cpu=y
# CONFIG_PACKAGE_collectd-mod-interface=y
# CONFIG_PACKAGE_collectd-mod-memory=y
# CONFIG_PACKAGE_collectd-mod-rrdtool=y
# CONFIG_PACKAGE_rrdtool=y

# ===== Netdata (资源占用大，不建议) =====
# CONFIG_PACKAGE_netdata=y

# ===== 打印服务器 =====
# CONFIG_PACKAGE_luci-app-p910nd=y
# CONFIG_PACKAGE_p910nd=y

# ===== Docker (需要USB扩展存储) =====
# CONFIG_PACKAGE_luci-app-dockerman=y
# CONFIG_PACKAGE_docker=y
# CONFIG_PACKAGE_dockerd=y

# ===== KMS激活服务 =====
# CONFIG_PACKAGE_luci-app-vlmcsd=y
# CONFIG_PACKAGE_vlmcsd=y

# ===== 访客网络 =====
# CONFIG_PACKAGE_luci-app-guest-wifi=y

# ===== 家长控制 =====
# CONFIG_PACKAGE_luci-app-accesscontrol=y

# ===== Tailscale =====
# CONFIG_PACKAGE_tailscale=y

#===============================================================================
# 排除不需要的包
#===============================================================================
# CONFIG_PACKAGE_luci-app-unblockmusic is not set
# CONFIG_PACKAGE_luci-app-music-remote-center is not set
# CONFIG_PACKAGE_luci-app-airplay2 is not set
# CONFIG_PACKAGE_luci-app-xlnetacc is not set
# CONFIG_PACKAGE_luci-app-zerotier is not set
